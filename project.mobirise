              }
            },
            "H1": {
              "color": "#ffffff"
            },
            "@media (max-width: 992px)": {
              ".col-lg-3": {
                "flex": "0 0 25%",
                "max-width": "25%",
                "position": "relative",
                "left": "-1.5rem"
              }
            },
            "@media (max-width: 202px)": {
              ".col-sm-12": {
                "flex": "0 0 25%",
                "max-width": "25%",
                "position": "relative",
                "left": "-9rem"
              }
            },
