          },
          "_name": "content16",
          "_customHTML": "<section class=\"mbr-section article content16\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"4\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"4\">\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#cccccc\">\n    <!-- End block parameters -->\n    </mbr-parameters> \n\n    <div class=\"container\">\n        <div class=\"media-container-row\">\n            <div class=\"mbr-text col-12 col-md-8\" mbr-theme-style=\"display-7\">\n                <div class=\"flex-block\">\n                    <span mbr-icon class=\"mbr-iconfont fa-quote-left fa\" style=\"color: rgb(149, 29, 25);\"></span>\n                    <p class=\"mbr-fonts-style block-quote\" data-app-selector=\".block-quote\" mbr-theme-style=\"display-7\">DSI launches an array of quality netwok design and support services in the Metropolitan DC/Baltimore area. DSI is ready and able to serve the region with its wide range of information technology services. Customer Service with a distinct difference that will always put its customer first, DSI is poised to introduce a new trend for customer satisfaction.<br></p>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "r3xHXrAEWM",
          "_anchor": "content16-6",
          "_protectedParams": [],
          "_global": false,
