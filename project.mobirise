              "justify-content": "center!important"
            }
          },
          "_customHTML": "<section group=\"Clients\" class=\"clients01\">\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n    <mbr-parameters>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"3\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"3\">\n        <input type=\"range\" inline title=\"Items\" name=\"items\" min=\"1\" max=\"8\" value=\"4\" step=\"1\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#951d19\">\n    </mbr-parameters>\n    <!-- End block parameters -->\n    <div class=\"container-fluid\">\n        <div class=\"row justify-content-space-between\">\n            <div class=\"col-md-12\">\n                <h1 class=\"mbr-section-title mbr-regular pb-3 align-center mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Some of Our Clients</h1>\n            </div>\n        </div>\n        <div class=\"row\">\n            <div class=\"col-lg-3 col-md-12 col-sm-12 card\">\n                <img src=\"@PROJECT_PATH@/assets/images/larger-frontline-realty-inc-250x170.png\" alt title>\n            </div>\n            <div class=\"col-lg-3 col-md-12 col-sm-12 card\">\n                <img src=\"@PROJECT_PATH@/assets/images/mahogany-inc-250x44.png\" alt title>\n            </div>\n            <div class=\"col-lg-3 col-md-12 col-sm-12 card\">\n                <img src=\"@PROJECT_PATH@/assets/images/sentara-logo.svg\" alt title>\n            </div>\n            <div class=\"col-lg-3 col-md-12 col-sm-12 card\">\n                <img src=\"@PROJECT_PATH@/assets/images/behavorial-health-services-219x67.png\" alt title>\n            </div>\n        </div>\n    </div>\n</section>",
